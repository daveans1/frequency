<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:background="@drawable/widget_pill_background"
    
    android:padding="8dp">

    <ImageView
        android:id="@+id/widget_identify_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/shortcut_mic"
        android:contentDescription="@string/recognize_music"
        android:layout_marginEnd="8dp" />

    <TextView
        android:id="@+id/widget_identify_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/recognize_music"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:maxLines="1" />
</LinearLayout>
