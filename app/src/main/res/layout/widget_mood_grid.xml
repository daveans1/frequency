<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:theme="@style/Theme.Widget.frequency"
    android:weightSum="4">

    <!-- Tile 1 -->
    <FrameLayout
        android:id="@+id/widget_mood_tile_1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="4dp"
        android:background="@drawable/widget_pill_background"
        android:clickable="true"
        android:focusable="true">
        
        <ImageView
            android:id="@+id/widget_mood_icon_1"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:src="@drawable/shortcut_heart"
             />

        <TextView
            android:id="@+id/widget_mood_text_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Mood 1"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="4dp"/>
    </FrameLayout>

    <!-- Tile 2 -->
    <FrameLayout
        android:id="@+id/widget_mood_tile_2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="4dp"
        android:background="@drawable/widget_pill_background"
        android:clickable="true"
        android:focusable="true">
        
        <ImageView
            android:id="@+id/widget_mood_icon_2"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:src="@drawable/shortcut_mic"
             />

        <TextView
            android:id="@+id/widget_mood_text_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Mood 2"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="4dp"/>
    </FrameLayout>

    <!-- Tile 3 -->
    <FrameLayout
        android:id="@+id/widget_mood_tile_3"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="4dp"
        android:background="@drawable/widget_pill_background"
        android:clickable="true"
        android:focusable="true">
        
        <ImageView
            android:id="@+id/widget_mood_icon_3"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:src="@drawable/shortcut_library"
             />

        <TextView
            android:id="@+id/widget_mood_text_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Mood 3"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="4dp"/>
    </FrameLayout>

    <!-- Tile 4 -->
    <FrameLayout
        android:id="@+id/widget_mood_tile_4"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_pill_background"
        android:clickable="true"
        android:focusable="true">
        
        <ImageView
            android:id="@+id/widget_mood_icon_4"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:src="@drawable/shortcut_search"
             />

        <TextView
            android:id="@+id/widget_mood_text_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Mood 4"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="4dp"/>
    </FrameLayout>
</LinearLayout>
