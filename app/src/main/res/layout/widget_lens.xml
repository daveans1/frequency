<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/Theme.Widget.frequency">

    <!-- Album Art - Full bleed -->
    <ImageView
        android:id="@+id/widget_lens_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="@string/album_art" />

    <!-- Controls Container (fades out if not interacting) -->
    <FrameLayout
        android:id="@+id/widget_lens_controls_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        
        <!-- Gradient overlay at the bottom -->
        <View
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_gravity="bottom"
            android:background="@drawable/widget_lens_gradient" />

        <!-- Bottom content: Song info and controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Song Info -->
            <TextView
                android:id="@+id/widget_lens_song_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/not_playing"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_lens_artist_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tap_to_play"
                android:textSize="14sp"
                android:textColor="#E0E0E0"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />

            <!-- Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/widget_lens_like_button"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_widget_heart_outline_nav"
                    android:scaleType="centerInside"
                    android:padding="8dp"
                    android:contentDescription="@string/like" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/widget_lens_prev_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_widget_skip_previous"
                    android:scaleType="centerInside"
                    android:padding="10dp"
                    android:contentDescription="@string/previous" />

                <ImageButton
                    android:id="@+id/widget_lens_play_pause"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_widget_play"
                    android:scaleType="centerInside"
                    android:padding="12dp"
                    android:contentDescription="@string/play_pause" />

                <ImageButton
                    android:id="@+id/widget_lens_next_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_widget_skip_next"
                    android:scaleType="centerInside"
                    android:padding="10dp"
                    android:contentDescription="@string/next" />
            </LinearLayout>

            <!-- Progress Bar -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="12dp">

                <ImageView
                    android:id="@+id/widget_lens_progress_track"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_progress_track"
                    android:scaleType="fitXY" />

                <ImageView
                    android:id="@+id/widget_lens_progress_fill"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_progress_clip"
                    android:scaleType="fitXY" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
